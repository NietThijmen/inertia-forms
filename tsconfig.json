{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "types": ["vitest/globals", "node"]
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.svelte",
        "tests/js/**/*.ts",
        "tests/js/**/*.svelte"
    ]
}
